OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
VMM_HTTP_MAX_REQUEST_BODY_BYTES=1048576
VMM_HTTP_CHAT_TIMEOUT=3s
VMM_HTTP_TLS_ENABLED=false
VMM_HTTP_TLS_CERT_FILE=
VMM_HTTP_TLS_KEY_FILE=
VMM_LOG_LEVEL=info
VMM_LOG_FORMAT=text
VMM_LOG_REQUEST_BODIES=false
VMM_PII_DEFAULT_LANGUAGE=zh-CN
VMM_ARCHIVE_PROVIDER=dockdb
VMM_DOCKDB_ADDRESS=127.0.0.1:50052
VMM_LANCEDB_ADDRESS=127.0.0.1:50051

# For any OpenAI-compatible provider, point OPENAI_BASE_URL at that provider's /v1 endpoint
# and reuse the OPENAI_* variables above.
