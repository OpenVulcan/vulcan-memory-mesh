OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
VMM_GRPC_MAX_RECEIVE_MESSAGE_BYTES=1048576
VMM_GRPC_WORKSPACE_TIMEOUT=15s
VMM_GRPC_PRE_CHECK_TIMEOUT=8s
VMM_GRPC_POST_ACTION_TIMEOUT=8s
VMM_LOG_LEVEL=info
VMM_LOG_FORMAT=text
VMM_PII_DEFAULT_LANGUAGE=zh-CN
VMM_RELATIONAL_PROVIDER=sqlite
VMM_VECTOR_PROVIDER=lancedb
VMM_SQLITE_ADDRESS=127.0.0.1:19501
VMM_LANCEDB_ADDRESS=127.0.0.1:19301
VMM_POST_ACTION_SESSION_ANALYSIS_TURN_THRESHOLD=2
VMM_POST_ACTION_SESSION_ANALYSIS_TOKEN_THRESHOLD=12000
VMM_POST_ACTION_SESSION_ANALYSIS_IDLE_TIMEOUT=15m
VMM_POST_ACTION_SESSION_ANALYSIS_HISTORY_TURNS=3
VMM_POST_ACTION_SESSION_ANALYSIS_MAX_INPUT_TOKENS=6000
VMM_LOG_PAYLOAD_ENCRYPTION_KEY=qwertyu1234567

# Optional full VMM overrides (defaults shown, commented to avoid unexpectedly overriding the JSON example files).
# 可选的完整 VMM 覆盖项（下面展示默认值，使用注释避免意外覆盖 JSON 示例文件）。
# VMM_GRPC_LISTEN_ADDR=:8080
# VMM_GRPC_SHUTDOWN_TIMEOUT=10s
# VMM_LOG_DEBUG_RPC_PAYLOADS=false
# VMM_LOG_PROTECT_PAYLOADS=false
# VMM_NOISE_ENABLED=true
# VMM_NOISE_DEFAULT_LANGUAGE=zh-CN
# VMM_NOISE_SEMANTIC_ENABLED=true
# VMM_NOISE_SEMANTIC_THRESHOLD=0.88
# VMM_SQLITE_TIMEOUT=5s
# VMM_LANCEDB_TIMEOUT=5s
# VMM_LANCEDB_TABLE_NAME=vmm_memory_vectors
# VMM_LANCEDB_VECTOR_COLUMN=vector
# VMM_LLM_PROVIDER=openai
# VMM_LLM_ENDPOINT=https://api.openai.com/v1
# VMM_LLM_API_KEY=
# VMM_LLM_MODEL=gpt-4.1-mini
# VMM_LLM_ORGANIZATION=
# VMM_LLM_PROJECT=
# VMM_EMBED_PROVIDER=openai
# VMM_EMBED_ENDPOINT=https://api.openai.com/v1
# VMM_EMBED_API_KEY=
# VMM_EMBED_MODEL=text-embedding-3-large
# VMM_EMBED_DIMENSION=1024
# VMM_EMBED_ORGANIZATION=
# VMM_EMBED_PROJECT=
# VMM_RERANK_ENABLED=false
# VMM_RERANK_PROVIDER=dashscope
# VMM_RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# VMM_RERANK_API_KEY=
# VMM_RERANK_MODEL=qwen3-vl-rerank
# VMM_RERANK_TOP_N=8
# VMM_RERANK_TIMEOUT=8s
# VMM_POST_ACTION_INPUT_MODE=compat
# VMM_PRE_CHECK_INTENT_TIMEOUT=5s
# VMM_PRE_CHECK_TOPK=5
# VMM_PRE_CHECK_SEARCH_SCOPE=space
# VMM_PRE_CHECK_SIMILARITY_THRESHOLD=0
# VMM_MEMORY_MAX_SEARCH_KEYWORDS=5
# VMM_MEMORY_MIN_SIMILARITY_SCORE=0.75
# VMM_MEMORY_HYBRID_ENABLED=true
# VMM_MEMORY_LEXICAL_TOP_K=8
# VMM_MEMORY_RRF_K=60
# VMM_MEMORY_MMR_ENABLED=true
# VMM_MEMORY_MMR_LAMBDA=0.75
# VMM_MEMORY_WEIBULL_ENABLED=true
# VMM_MEMORY_WEIBULL_SHAPE=1.35
# VMM_MEMORY_WEIBULL_SCALE_HOURS=2160
# VMM_MEMORY_WEIBULL_MIN_MULTIPLIER=0.4
# VMM_MEMORY_WEIBULL_REINFORCE_WEIGHT=0.18
# VMM_MEMORY_WEIBULL_CROSS_SESSION_BOOST=0.12

# For any OpenAI-compatible provider, point OPENAI_BASE_URL at that provider's /v1 endpoint
# and reuse the OPENAI_* variables above.
# LanceDB appends the embedding dimension to the configured base table name at runtime.
# LanceDB 会在运行时把 embedding 维度追加到配置的基础表名后面。
