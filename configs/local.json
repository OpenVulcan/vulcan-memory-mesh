{
  "http": {
    "listen_addr": "127.0.0.1:8080",
    "max_request_body_bytes": 1048576,
    "request_timeout": {
      "pre_check": "3s",
      "post_action": "3s",
      "seed_memory": "3s"
    },
    "shutdown_timeout": "10s",
    "tls": {
      "enabled": false,
      "cert_file": "",
      "key_file": ""
    }
  },
  "logging": {
    "level": "info",
    "format": "text",
    "log_request_bodies": true
  },
  "llm": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_MODEL}",
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}"
  },
  "embedding": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_EMBEDDING_MODEL}",
    "dimension": 1024,
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}"
  },
  "vector": {
    "provider": "memory"
  },
  "relational": {
    "provider": "memory"
  },
  "precheck": {
    "intent_timeout": "2s",
    "top_k": 5
  },
  "memory_pipeline": {
    "max_search_keywords": 5,
    "min_similarity_score": 0.75
  },
  "admin": {
    "seed_enabled": true
  }
}
