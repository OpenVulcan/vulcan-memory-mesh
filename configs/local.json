{
  "http": {
    "listen_addr": "127.0.0.1:17625",
    "max_request_body_bytes": 1048576,
    "request_timeout": {
      "chat": "3s",
      "pre_check": "3s",
      "post_action": "3s",
      "seed_memory": "3s"
    },
    "shutdown_timeout": "10s",
    "tls": {
      "enabled": false,
      "cert_file": "",
      "key_file": ""
    }
  },
  "logging": {
    "level": "info",
    "format": "text",
    "log_request_bodies": false
  },
  "pii": {
    "default_language": "zh-CN"
  },
  "noise": {
    "enabled": true,
    "default_language": "zh-CN",
    "semantic_enabled": true,
    "semantic_threshold": 0.88
  },
  "archive": {
    "provider": "sqlite",
    "path": "../data/vmm.db"
  },
  "llm": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_MODEL}",
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}",
    "model_params": {
      "${OPENAI_MODEL}": {
        "enable_thinking": false
      }
    }
  },
  "embedding": {
    "provider": "openai",
    "endpoint": "${OPENAI_EMBEDDING_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_EMBEDDING_MODEL}",
    "dimension": 1024,
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}"
  },
  "vector": {
    "provider": "memory"
  },
  "relational": {
    "provider": "memory"
  },
  "post_action": {
    "input_mode": "compat"
  },
  "precheck": {
    "intent_timeout": "2s",
    "top_k": 5
  },
  "memory_pipeline": {
    "max_search_keywords": 5,
    "min_similarity_score": 0.75
  },
  "admin": {
    "seed_enabled": true
  }
}
