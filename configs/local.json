{
  "grpc": {
    "listen_addr": "127.0.0.1:17625",
    "max_receive_message_bytes": 1048576,
    "request_timeout": {
      "workspace": "15s",
      "pre_check": "8s",
      "post_action": "8s"
    },
    "shutdown_timeout": "10s"
  },
  "logging": {
    "level": "info",
    "format": "text",
    "debug_rpc_payloads": true,
    "protect_payloads": false,
    "payload_encryption_key": ""
  },
  "pii": {
    "default_language": "zh-CN"
  },
  "noise": {
    "enabled": true,
    "default_language": "zh-CN",
    "semantic_enabled": true,
    "semantic_threshold": 0.88
  },
  "sqlite": {
    "address": "${VMM_SQLITE_ADDRESS}",
    "timeout": "5s"
  },
  "lancedb": {
    "address": "${VMM_LANCEDB_ADDRESS}",
    "timeout": "5s",
    "table_name": "vmm_memory_vectors",
    "vector_column": "vector"
  },
  "llm": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_MODEL}",
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}",
    "params": {},
    "model_params": {
      "${OPENAI_MODEL}": {
        "enable_thinking": false
      }
    }
  },
  "embedding": {
    "provider": "openai",
    "endpoint": "${OPENAI_EMBEDDING_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_EMBEDDING_MODEL}",
    "dimension": 1024,
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}",
    "params": {},
    "model_params": {}
  },
  "rerank": {
    "enabled": false,
    "provider": "dashscope",
    "endpoint": "https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank",
    "api_key": "${OPENAI_API_KEY}",
    "model": "qwen3-vl-rerank",
    "top_n": 8,
    "timeout": "8s"
  },
  "vector": {
    "provider": "${VMM_VECTOR_PROVIDER}"
  },
  "relational": {
    "provider": "sqlite"
  },
  "post_action": {
    "input_mode": "compat",
    "session_analysis_turn_threshold": 2,
    "session_analysis_token_threshold": 12000,
    "session_analysis_idle_timeout": "15m",
    "session_analysis_history_turns": 3,
    "session_analysis_max_input_tokens": 6000
  },
  "pre_check": {
    "intent_timeout": "5s",
    "top_k": 5,
    "search_scope": "space",
    "similarity_threshold": 0
  },
  "memory_pipeline": {
    "max_search_keywords": 5,
    "min_similarity_score": 0.75,
    "hybrid_enabled": true,
    "lexical_top_k": 8,
    "rrf_k": 60,
    "mmr_enabled": true,
    "mmr_lambda": 0.75,
    "weibull_enabled": true,
    "weibull_shape": 1.35,
    "weibull_scale_hours": 2160,
    "weibull_min_multiplier": 0.4,
    "weibull_reinforce_weight": 0.18,
    "weibull_cross_session_boost": 0.12
  }
}
