{
  "grpc": {
    "listen_addr": "127.0.0.1:17625",
    "max_receive_message_bytes": 1048576,
    "request_timeout": {
      "chat": "3s",
      "pre_check": "3s",
      "post_action": "3s",
      "seed_memory": "3s"
    },
    "shutdown_timeout": "10s"
  },
  "logging": {
    "level": "info",
    "format": "text"
  },
  "pii": {
    "default_language": "zh-CN"
  },
  "noise": {
    "enabled": true,
    "default_language": "zh-CN",
    "semantic_enabled": true,
    "semantic_threshold": 0.88
  },
  "dockdb": {
    "address": "127.0.0.1:50052",
    "timeout": "5s"
  },
  "lancedb": {
    "address": "127.0.0.1:50051",
    "timeout": "5s",
    "table_name": "vmm_memory_vectors",
    "vector_column": "vector"
  },
  "archive": {
    "provider": "dockdb"
  },
  "llm": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_MODEL}",
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}",
    "model_params": {
      "${OPENAI_MODEL}": {
        "enable_thinking": false
      }
    }
  },
  "embedding": {
    "provider": "openai",
    "endpoint": "${OPENAI_EMBEDDING_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_EMBEDDING_MODEL}",
    "dimension": 1024,
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}"
  },
  "vector": {
    "provider": "lancedb"
  },
  "relational": {
    "provider": "dockdb"
  },
  "post_action": {
    "input_mode": "compat"
  },
  "precheck": {
    "intent_timeout": "2s",
    "top_k": 5
  },
  "memory_pipeline": {
    "max_search_keywords": 5,
    "min_similarity_score": 0.75
  },
  "admin": {
    "seed_enabled": true
  }
}
