{
  "language": "en-IN",
  "version": "2.0.0",
  "rules": [
    { "name": "IN_AADHAAR", "pattern": "\\b\\d{4}[ -]\\d{4}[ -]\\d{4}\\b", "replacement": "[IN_AADHAAR_MASKED]" },
    { "name": "IN_PAN", "pattern": "\\b[A-Z]{5}\\d{4}[A-Z]\\b", "replacement": "[IN_PAN_MASKED]" },
    { "name": "IN_GSTIN", "pattern": "\\b\\d{2}[A-Z]{5}\\d{4}[A-Z][1-9A-Z]Z[0-9A-Z]\\b", "replacement": "[IN_GSTIN_MASKED]" },
    { "name": "IN_PHONE_NUMBER", "pattern": "\\b(?:\\+91[ -]?)?[6-9]\\d{9}\\b", "replacement": "[IN_PHONE_MASKED]" },
    { "name": "IN_STREET_ADDRESS", "pattern": "\\b\\d{1,4}[A-Za-z]?(?:/\\d{1,4})?\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){0,3}(?:Road|Rd|Street|St|Lane|Ln|Nagar|Marg)\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
