{
  "language": "th-TH",
  "version": "2.0.0",
  "rules": [
    { "name": "TH_NATIONAL_ID", "pattern": "\\b\\d-\\d{4}-\\d{5}-\\d{2}-\\d\\b", "replacement": "[TH_ID_MASKED]" },
    { "name": "TH_PHONE_NUMBER", "pattern": "\\b(?:\\+66[ -]?)?0?[689]\\d[ -]?\\d{3}[ -]?\\d{4}\\b", "replacement": "[TH_PHONE_MASKED]" },
    { "name": "TH_STREET_ADDRESS", "pattern": "(?:ถนน|ซอย|หมู่บ้าน)\\s*[ก-๙A-Za-z0-9./-]{2,30}(?:\\s*[ก-๙A-Za-z0-9./-]{2,30}){0,2}\\s*\\d{1,4}/?\\d{0,4}", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
