{
  "language": "zh-HK",
  "version": "2.0.0",
  "rules": [
    { "name": "HK_ID_CARD", "pattern": "\\b[A-Z]{1,2}\\d{6}\\([0-9A]\\)\\b", "replacement": "[HK_ID_MASKED]" },
    { "name": "HK_STREET_ADDRESS", "pattern": "((?:[\\p{Han}A-Za-z0-9]{2,24})(?:大道中|大道西|大道東|道|街|路))((?:\\s*\\d{1,4}號(?:\\s*\\d{1,4}(?:室|樓))?))", "replacement": "$1[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
