{
  "language": "ar-AE",
  "version": "2.0.0",
  "rules": [
    { "name": "AE_EMIRATES_ID", "pattern": "\\b784-\\d{4}-\\d{7}-\\d\\b", "replacement": "[AE_ID_MASKED]" },
    { "name": "AE_PHONE_NUMBER", "pattern": "\\b(?:\\+971[ -]?)?0?5\\d[ -]?\\d{3}[ -]?\\d{4}\\b", "replacement": "[AE_PHONE_MASKED]" },
    { "name": "AE_STREET_ADDRESS", "pattern": "\\b(?:[A-Za-z0-9.'-]{2,20}\\s+){1,3}(?:Road|Rd|Street|St|Avenue|Ave)\\s+\\d{1,4}\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
