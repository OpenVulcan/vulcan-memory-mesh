{
  "language": "zh-TW",
  "version": "2.0.0",
  "rules": [
    { "name": "TW_ID_CARD", "pattern": "\\b[A-Z][1289]\\d{8}\\b", "replacement": "[TW_ID_MASKED]" },
    { "name": "TW_MOBILE_NUMBER", "pattern": "\\b09\\d{8}\\b", "replacement": "[TW_MOBILE_MASKED]" },
    { "name": "TW_STREET_ADDRESS", "pattern": "((?:[\\p{Han}A-Za-z0-9]{2,24})(?:路|街|大道)(?:[一二三四五六七八九十百千0-9]+段)?)(\\s*\\d{1,4}(?:號|号)(?:\\s*\\d{1,4}(?:樓|楼|室))?)", "replacement": "$1[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
