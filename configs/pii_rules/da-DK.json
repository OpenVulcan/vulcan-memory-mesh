{
  "language": "da-DK",
  "version": "2.0.0",
  "rules": [
    { "name": "DK_CPR", "pattern": "\\b\\d{6}-\\d{4}\\b", "replacement": "[DK_ID_MASKED]" },
    { "name": "DK_PHONE_NUMBER", "pattern": "\\b(?:\\+45[ -]?)?\\d{2}[ -]?\\d{2}[ -]?\\d{2}[ -]?\\d{2}\\b", "replacement": "[DK_PHONE_MASKED]" },
    { "name": "DK_STREET_ADDRESS", "pattern": "\\b[A-Za-zÀ-ÿÆØÅæøå0-9.'-]{2,30}(?:gade|vej)\\s+\\d{1,4}[A-Za-z]?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
