{
  "language": "en-NZ",
  "version": "2.0.0",
  "rules": [
    { "name": "NZ_IRD", "pattern": "\\b\\d{3}[ -]\\d{3}[ -]\\d{3}\\b", "replacement": "[NZ_IRD_MASKED]" },
    { "name": "NZ_PHONE_NUMBER", "pattern": "\\b(?:\\+64[ -]?)?0?2\\d[ -]?\\d{3}[ -]?\\d{3,4}\\b", "replacement": "[NZ_PHONE_MASKED]" },
    { "name": "NZ_STREET_ADDRESS", "pattern": "\\b\\d{1,6}\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){1,4}(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Crescent|Cres)\\b(?:\\s+(?:Unit|Suite|Apt)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
