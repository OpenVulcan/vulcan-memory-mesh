{
  "language": "vi-VN",
  "version": "2.0.0",
  "rules": [
    { "name": "VN_PHONE_NUMBER", "pattern": "\\b(?:\\+84[ -]?)?(?:0)?[35789]\\d{8}\\b", "replacement": "[VN_PHONE_MASKED]" },
    { "name": "VN_STREET_ADDRESS", "pattern": "(?:Đường|Duong|Phố|Pho|Ngõ|Ngo|Hẻm|Hem)\\s+(?:[A-Za-zÀ-ỹ0-9./-]{2,20}\\s+){1,4}\\d{1,4}[A-Za-z]?(?:/\\d{1,4})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
