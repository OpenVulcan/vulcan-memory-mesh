{
  "language": "es-PE",
  "version": "2.0.0",
  "rules": [
    { "name": "PE_RUC", "pattern": "\\b(?:10|15|17|20)\\d{9}\\b", "replacement": "[PE_RUC_MASKED]" },
    { "name": "PE_PHONE_NUMBER", "pattern": "\\b9\\d{8}\\b", "replacement": "[PE_PHONE_MASKED]" },
    { "name": "PE_STREET_ADDRESS", "pattern": "(?:Calle|Avenida|Av\\.?|Jir[oó]n|JR\\.?|Pasaje)\\s+(?:[A-Za-zÀ-ÿ0-9.'-]{2,20}\\s+){1,4}\\d{1,6}[A-Za-z]?(?:\\s*(?:Depto|Departamento|Casa|Oficina)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
