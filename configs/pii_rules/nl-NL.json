{
  "language": "nl-NL",
  "version": "2.0.0",
  "rules": [
    { "name": "NL_VAT_ID", "pattern": "\\bNL\\d{9}B\\d{2}\\b", "replacement": "[NL_VAT_MASKED]" },
    { "name": "NL_MOBILE_NUMBER", "pattern": "\\b(?:\\+31[ -]?6|06)[ -]?\\d{8}\\b", "replacement": "[NL_PHONE_MASKED]" },
    { "name": "NL_STREET_ADDRESS", "pattern": "\\b[A-Za-zÀ-ÿ0-9.'-]{2,30}(?:straat|laan|plein|gracht|weg)\\s+\\d{1,4}[A-Za-z]?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
