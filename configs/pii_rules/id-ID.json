{
  "language": "id-ID",
  "version": "2.0.0",
  "rules": [
    { "name": "ID_NPWP", "pattern": "\\b\\d{2}\\.\\d{3}\\.\\d{3}\\.\\d-\\d{3}\\.\\d{3}\\b", "replacement": "[ID_NPWP_MASKED]" },
    { "name": "ID_PHONE_NUMBER", "pattern": "\\b(?:\\+62[ -]?)?0?8\\d{2}[ -]?\\d{3,4}[ -]?\\d{3,4}\\b", "replacement": "[ID_PHONE_MASKED]" },
    { "name": "ID_STREET_ADDRESS", "pattern": "(?:Jl\\.?|Jalan|Gg\\.?|Gang|Komplek)\\s+(?:[A-Za-zÀ-ÿ0-9./-]{2,20}\\s+){1,4}\\d{1,4}[A-Za-z]?(?:/\\d{1,4})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
