{
  "language": "es-ES",
  "version": "2.0.0",
  "rules": [
    { "name": "ES_DNI_NIE", "pattern": "\\b(?:\\d{8}[A-HJ-NP-TV-Z]|[XYZ]\\d{7}[A-HJ-NP-TV-Z])\\b", "replacement": "[ES_ID_MASKED]" },
    { "name": "ES_CIF", "pattern": "\\b[A-HJNPQRSUVW]\\d{7}[0-9A-J]\\b", "replacement": "[ES_CIF_MASKED]" },
    { "name": "ES_PHONE_NUMBER", "pattern": "\\b(?:\\+34[ -]?)?[6789]\\d{8}\\b", "replacement": "[ES_PHONE_MASKED]" },
    { "name": "ES_STREET_ADDRESS", "pattern": "(?:Calle|Avenida|Av\\.?|Paseo|Plaza|Camino)\\s+(?:[A-Za-zÀ-ÿ0-9.'-]{2,20}\\s+){1,4}\\d{1,6}[A-Za-z]?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
