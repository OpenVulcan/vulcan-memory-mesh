{
  "language": "it-IT",
  "version": "2.0.0",
  "rules": [
    { "name": "IT_CODICE_FISCALE", "pattern": "\\b[A-Z]{6}\\d{2}[A-EHLMPR-T][0-7]\\d[A-Z]\\d{3}[A-Z]\\b", "replacement": "[IT_CF_MASKED]" },
    { "name": "IT_VAT_ID", "pattern": "\\bIT\\d{11}\\b", "replacement": "[IT_VAT_MASKED]" },
    { "name": "IT_MOBILE_NUMBER", "pattern": "\\b(?:\\+39[ -]?)?3\\d{2}[ -]?\\d{6,7}\\b", "replacement": "[IT_PHONE_MASKED]" },
    { "name": "IT_STREET_ADDRESS", "pattern": "(?:Via|Viale|Piazza|Corso|Largo)\\s+(?:[A-Za-zÀ-ÿ0-9.'-]{2,20}\\s+){1,4}\\d{1,6}[A-Za-z]?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
