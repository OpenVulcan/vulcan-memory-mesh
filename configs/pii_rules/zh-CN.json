{
  "language": "zh-CN",
  "version": "2.0.0",
  "rules": [
    {
      "name": "CN_ID_CARD",
      "pattern": "\\b(\\d{17})([0-9Xx])\\b",
      "replacement": "[CN_ID_VERIFIED]",
      "condition": "(weight_sum($1, [7,9,10,5,8,4,2,1,6,3,7,9,10,5,8,4,2]) % 11) == cn_check($2)"
    },
    {
      "name": "UNIONPAY_DEBIT_CARD",
      "pattern": "\\b62\\d{14,17}\\b",
      "replacement": "[UNIONPAY_CARD_MASKED]",
      "condition": "len($0) >= 16 && len($0) <= 19 && is_luhn($0)"
    },
    {
      "name": "CN_MOBILE_NUMBER",
      "pattern": "\\b1[3-9]\\d{9}\\b",
      "replacement": "[MOBILE_MASKED]"
    },
    {
      "name": "CN_USCC",
      "pattern": "\\b[159Y][1239]\\d{6}[0-9ABCDEFGHJKLMNPQRTUWXY]{0,9}[ABCDEFGHJKLMNPQRTUWXY][0-9ABCDEFGHJKLMNPQRTUWXY]{0,9}\\b",
      "replacement": "[CORP_TAX_ID_MASKED]",
      "condition": "len($0) == 18"
    },
    {
      "name": "CN_PASSPORT",
      "pattern": "\\b(?:[EG]\\d{8}|1[45]\\d{7})\\b",
      "replacement": "[PASSPORT_MASKED]"
    },
    {
      "name": "CN_LANDLINE",
      "pattern": "\\b0\\d{2,3}-\\d{7,8}\\b",
      "replacement": "[LANDLINE_MASKED]"
    },
    {
      "name": "CN_LICENSE_PLATE",
      "pattern": "[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼使领警学港澳][A-Z][A-HJ-NP-Z0-9]{5,6}",
      "replacement": "[LICENSE_PLATE_MASKED]"
    },
    {
      "name": "CN_STREET_ADDRESS",
      "pattern": "((?:[A-Za-z0-9]{2,20}|[\\p{Han}]{2,10})(?:路|街|巷|弄|胡同|大道|道))((?:(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:号|栋|幢|楼|座)){1,3}(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:单元|室|户)){1,2}(?:\\s*\\d{1,4}(?:室|户)?)?|(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:号|栋|幢|楼|座)){1,4}(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:单元|室|户)){0,2}(?:\\s*\\d{1,3}\\b)?))",
      "replacement": "$1[SPECIFIC_ADDRESS_MASKED]"
    },
    {
      "name": "CN_COMPOUND_ADDRESS",
      "pattern": "((?:[A-Za-z0-9]{2,20}|[\\p{Han}]{2,10})(?:小区|苑|花园|公寓))((?:(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:号|栋|幢|楼|座)){1,3}(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:单元|室|户)){1,2}(?:\\s*\\d{1,4}(?:室|户)?)?|(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:号|栋|幢|楼|座)){1,4}(?:\\s*[0-9A-Za-z甲乙丙丁一二三四五六七八九十-]{1,8}\\s*(?:单元|室|户)){0,2}(?:\\s*\\d{1,3}\\b)?))",
      "replacement": "$1[SPECIFIC_ADDRESS_MASKED]"
    }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
