{
  "language": "en-PH",
  "version": "2.0.0",
  "rules": [
    { "name": "PH_TIN", "pattern": "\\b\\d{3}-\\d{3}-\\d{3}-\\d{3}\\b", "replacement": "[PH_TIN_MASKED]" },
    { "name": "PH_PHONE_NUMBER", "pattern": "\\b(?:\\+63[ -]?)?0?9\\d{2}[ -]?\\d{3}[ -]?\\d{4}\\b", "replacement": "[PH_PHONE_MASKED]" },
    { "name": "PH_STREET_ADDRESS", "pattern": "\\b\\d{1,4}[A-Za-z]?\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){0,2}(?:Street|St|Road|Rd|Avenue|Ave|Extension|Ext\\.)\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
