{
  "language": "ko-KR",
  "version": "2.0.0",
  "rules": [
    { "name": "KR_RRN", "pattern": "\\b\\d{6}-[1-4]\\d{6}\\b", "replacement": "[KR_RRN_MASKED]" },
    { "name": "KR_BUSINESS_REG_NO", "pattern": "\\b\\d{3}-\\d{2}-\\d{5}\\b", "replacement": "[KR_BRN_MASKED]" },
    { "name": "KR_MOBILE_NUMBER", "pattern": "\\b01[016789]-\\d{3,4}-\\d{4}\\b", "replacement": "[KR_MOBILE_MASKED]" },
    { "name": "KR_STREET_ADDRESS", "pattern": "([가-힣A-Za-z0-9]{2,20}(?:로|길))(\\s*\\d{1,4}(?:-\\d{1,4})?(?:\\s*\\d{1,4}동)?(?:\\s*\\d{1,4}호)?)", "replacement": "$1[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
