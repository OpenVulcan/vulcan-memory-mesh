{
  "language": "tr-TR",
  "version": "2.0.0",
  "rules": [
    { "name": "TR_TC_KIMLIK", "pattern": "\\b[1-9]\\d{10}\\b", "replacement": "[TR_ID_MASKED]" },
    { "name": "TR_MOBILE_NUMBER", "pattern": "\\b(?:\\+90[ -]?)?0?5\\d{2}[ -]?\\d{3}[ -]?\\d{4}\\b", "replacement": "[TR_PHONE_MASKED]" },
    { "name": "TR_STREET_ADDRESS", "pattern": "\\b(?:[A-Za-zÇĞİÖŞÜçğıöşü0-9.'-]{2,20}\\s+){1,3}(?:Sokak|Sk\\.?|Cadde|Cd\\.?|Bulvarı|Mahallesi)\\s*\\d{1,4}[A-Za-z]?(?:/\\d{1,4})?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
