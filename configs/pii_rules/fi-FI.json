{
  "language": "fi-FI",
  "version": "2.0.0",
  "rules": [
    { "name": "FI_HETU", "pattern": "\\b\\d{6}[+-A]\\d{3}[0-9A-Y]\\b", "replacement": "[FI_ID_MASKED]" },
    { "name": "FI_MOBILE_NUMBER", "pattern": "\\b(?:\\+358[ -]?4\\d|04\\d)[ -]?\\d{3,4}[ -]?\\d{4}\\b", "replacement": "[FI_PHONE_MASKED]" },
    { "name": "FI_STREET_ADDRESS", "pattern": "\\b[A-Za-zÀ-ÿÅÄÖåäö0-9.'-]{2,30}(?:katu|tie|kuja)\\s+\\d{1,4}[A-Za-z]?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
