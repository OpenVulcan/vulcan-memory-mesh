{
  "language": "nb-NO",
  "version": "2.0.0",
  "rules": [
    { "name": "NO_VAT_ID", "pattern": "\\bNO\\d{9}MVA\\b", "replacement": "[NO_VAT_MASKED]" },
    { "name": "NO_MOBILE_NUMBER", "pattern": "\\b(?:\\+47[ -]?)?(?:4\\d|9\\d)\\d{6}\\b", "replacement": "[NO_PHONE_MASKED]" },
    { "name": "NO_STREET_ADDRESS", "pattern": "\\b(?:[A-Za-zÀ-ÿÆØÅæøå0-9.'-]{2,20}\\s+){1,3}(?:gata|gate|veien|vei)\\s+\\d{1,4}[A-Za-z]?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
