{
  "language": "en-MY",
  "version": "2.0.0",
  "rules": [
    { "name": "MY_NRIC", "pattern": "\\b\\d{6}-\\d{2}-\\d{4}\\b", "replacement": "[MY_NRIC_MASKED]" },
    { "name": "MY_PHONE_NUMBER", "pattern": "\\b(?:\\+60[ -]?)?01\\d-[ -]?\\d{3,4}[ -]?\\d{4}\\b", "replacement": "[MY_PHONE_MASKED]" },
    { "name": "MY_STREET_ADDRESS", "pattern": "(?:Jalan|Lorong|Persiaran|Taman)\\s+(?:[A-Za-z0-9.'/-]{2,20}\\s+){1,4}\\d{1,4}[A-Za-z]?(?:/\\d{1,4})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
