{
  "language": "en-US",
  "version": "2.0.0",
  "rules": [
    { "name": "US_SSN", "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "replacement": "[US_SSN_MASKED]" },
    { "name": "US_EIN", "pattern": "\\b\\d{2}-\\d{7}\\b", "replacement": "[US_EIN_MASKED]" },
    { "name": "US_PHONE_NUMBER", "pattern": "(?:\\+1[ -]?)?(?:\\([2-9]\\d{2}\\)|[2-9]\\d{2})[ -]?[2-9]\\d{2}[ -]?\\d{4}\\b", "replacement": "[US_PHONE_MASKED]" },
    { "name": "US_STREET_ADDRESS", "pattern": "\\b\\d{1,6}\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){1,4}(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Boulevard|Blvd|Court|Ct|Way|Terrace|Ter)\\b(?:\\s+(?:Apt|Suite|Ste|Unit)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
