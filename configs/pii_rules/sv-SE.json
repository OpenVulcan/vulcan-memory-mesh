{
  "language": "sv-SE",
  "version": "2.0.0",
  "rules": [
    { "name": "SE_PERSONNUMMER", "pattern": "\\b\\d{6}[-+]\\d{4}\\b", "replacement": "[SE_ID_MASKED]" },
    { "name": "SE_MOBILE_NUMBER", "pattern": "\\b(?:\\+46[ -]?7\\d|07\\d)[ -]?\\d{3}[ -]?\\d{2}[ -]?\\d{2}\\b", "replacement": "[SE_PHONE_MASKED]" },
    { "name": "SE_STREET_ADDRESS", "pattern": "\\b[A-Za-zÀ-ÿÅÄÖåäö0-9.'-]{2,30}(?:gatan|vägen|väg|all[eé]n)\\s+\\d{1,4}[A-Za-z]?\\b", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
