{
  "language": "en-AU",
  "version": "2.0.0",
  "rules": [
    { "name": "AU_TFN", "pattern": "\\b\\d{3}[ -]\\d{3}[ -]\\d{3}\\b", "replacement": "[AU_TFN_MASKED]" },
    { "name": "AU_ABN", "pattern": "\\b\\d{2}[ -]\\d{3}[ -]\\d{3}[ -]\\d{3}\\b", "replacement": "[AU_ABN_MASKED]" },
    { "name": "AU_PHONE_NUMBER", "pattern": "\\b(?:\\+61[ -]?)?0?4\\d{2}[ -]?\\d{3}[ -]?\\d{3}\\b", "replacement": "[AU_PHONE_MASKED]" },
    { "name": "AU_STREET_ADDRESS", "pattern": "\\b\\d{1,6}\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){1,4}(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Parade|Pde|Close|Cl)\\b(?:\\s+(?:Unit|Suite|Apt)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
