{
  "language": "en-GB",
  "version": "2.0.0",
  "rules": [
    { "name": "GB_NINO", "pattern": "\\b[A-CEGHJ-PR-TW-Z]{2}\\d{6}[A-D]\\b", "replacement": "[GB_NINO_MASKED]" },
    { "name": "GB_NHS_NUMBER", "pattern": "\\b\\d{3}[ -]\\d{3}[ -]\\d{4}\\b", "replacement": "[GB_NHS_MASKED]" },
    { "name": "GB_MOBILE_NUMBER", "pattern": "\\b(?:\\+44[ -]?7\\d{3}|07\\d{3})[ -]?\\d{6}\\b", "replacement": "[GB_PHONE_MASKED]" },
    { "name": "GB_STREET_ADDRESS", "pattern": "\\b\\d{1,6}\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){1,4}(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Close|Way|Court|Ct)\\b(?:\\s+(?:Flat|Apt|Suite|Unit)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
