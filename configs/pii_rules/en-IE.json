{
  "language": "en-IE",
  "version": "2.0.0",
  "rules": [
    { "name": "IE_PPSN", "pattern": "\\b\\d{7}[A-W][A-I]?\\b", "replacement": "[IE_PPSN_MASKED]" },
    { "name": "IE_MOBILE_NUMBER", "pattern": "\\b(?:\\+353[ -]?8\\d|08\\d)[ -]?\\d{3}[ -]?\\d{4}\\b", "replacement": "[IE_PHONE_MASKED]" },
    { "name": "IE_STREET_ADDRESS", "pattern": "\\b\\d{1,6}\\s+(?:[A-Za-z0-9.'-]{2,20}\\s+){1,4}(?:Road|Rd|Street|St|Avenue|Ave|Park|Close|Way|Drive|Dr)\\b(?:\\s+(?:Apt|Suite|Unit)\\s*[A-Za-z0-9-]{1,8})?", "replacement": "[SPECIFIC_ADDRESS_MASKED]" }
  ],
  "excludes": ["session_id", "request_id", "max_tokens"]
}
