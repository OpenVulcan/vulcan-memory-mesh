{
  "grpc": {
    "listen_addr": "127.0.0.1:17625",
    "max_receive_message_bytes": 1048576,
    "request_timeout": {
      "workspace": "15s",
      "pre_check": "8s",
      "post_action": "8s"
    },
    "shutdown_timeout": "10s"
  },
  "logging": {
    "level": "info",
    "format": "text"
  },
  "pii": {
    "default_language": "zh-CN"
  },
  "noise": {
    "enabled": true,
    "default_language": "zh-CN",
    "semantic_enabled": true,
    "semantic_threshold": 0.88
  },
  "duckdb": {
    "address": "${VMM_DUCKDB_ADDRESS}",
    "timeout": "5s"
  },
  "lancedb": {
    "address": "${VMM_LANCEDB_ADDRESS}",
    "timeout": "5s",
    "table_name": "vmm_memory_vectors",
    "vector_column": "vector"
  },
  "llm": {
    "provider": "openai",
    "endpoint": "${OPENAI_BASE_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_MODEL}",
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}",
    "params": {
      "enable_thinking": false
    },
    "model_params": {
      "${OPENAI_MODEL}": {
        "enable_thinking": false
      }
    }
  },
  "embedding": {
    "provider": "openai",
    "endpoint": "${OPENAI_EMBEDDING_URL}",
    "api_key": "${OPENAI_API_KEY}",
    "model": "${OPENAI_EMBEDDING_MODEL}",
    "dimension": 1024,
    "organization": "${OPENAI_ORGANIZATION}",
    "project": "${OPENAI_PROJECT}"
  },
  "vector": {
    "provider": "${VMM_VECTOR_PROVIDER}"
  },
  "relational": {
    "provider": "${VMM_RELATIONAL_PROVIDER}"
  },
  "post_action": {
    "input_mode": "compat",
    "session_analysis_turn_threshold": 20,
    "session_analysis_token_threshold": 12000,
    "session_analysis_idle_timeout": "15m"
  },
  "pre_check": {
    "intent_timeout": "5s",
    "top_k": 5
  },
  "memory_pipeline": {
    "max_search_keywords": 5,
    "min_similarity_score": 0.75
  }
}
